{
  "version": 2,
  "bundle": "com.github.happy-sdk.happy.sdk.app",
  "locales": {
    "ru": {
      "notes": "sdk/app's own runtime log messages.",
      "keys": {
        "internal": {
          "initializer": {
            "initializing": {
              "$message": {
                "msg": "инициализация",
                "description": {
                  "msg": "Отладочное сообщение журнала, выводимое при запуске инициализатора приложения."
                }
              }
            },
            "initialization_completed": {
              "$message": {
                "msg": "инициализация завершена",
                "description": {
                  "msg": "Отладочное сообщение журнала, выводимое по завершении инициализации приложения."
                }
              }
            }
          },
          "application": {
            "booting_application": {
              "$message": {
                "msg": "загрузка приложения",
                "description": {
                  "msg": "Отладочное сообщение журнала, выводимое, когда приложение начинает загружаться."
                }
              }
            },
            "application_booted": {
              "$message": {
                "msg": "приложение загружено",
                "description": {
                  "msg": "Отладочное сообщение журнала, выводимое после завершения загрузки приложения."
                }
              }
            },
            "starting_application": {
              "$message": {
                "msg": "запуск приложения",
                "description": {
                  "msg": "Отладочное сообщение журнала, выводимое при запуске приложения."
                }
              }
            },
            "shutdown_complete": {
              "$message": {
                "msg": "завершение работы выполнено",
                "description": {
                  "msg": "Отладочное сообщение журнала, выводимое по завершении остановки приложения."
                }
              }
            }
          }
        },
        "preparing_runtime": {
          "$message": {
            "msg": "подготовка среды выполнения",
            "description": {
              "msg": "Отладочное сообщение журнала, выводимое непосредственно перед подготовкой среды выполнения приложения."
            }
          }
        }
      }
    }
  }
}
