{
  "version": 2,
  "bundle": "com.github.happy-sdk.happy.sdk.cli",
  "locales": {
    "ru": {
      "notes": "sdk/cli's own command help text, flag descriptions, and the built-in config command.",
      "keys": {
        "cmd": {
          "config": {
            "category": {
              "$message": {
                "msg": "Конфигурация",
                "description": {
                  "msg": "Метка категории, отображаемая в справке CLI, группирующая команду config с другими командами того же типа."
                }
              }
            },
            "description": {
              "$message": {
                "msg": "Управление и настройка параметров приложения",
                "description": {
                  "msg": "Однострочное описание команды config, отображаемое в списках справки CLI."
                }
              }
            },
            "info": {
              "$message": {
                "msg": "Эта команда позволяет управлять настройками конфигурации приложения и профилями настроек.",
                "description": {
                  "msg": "Более длинный текст справки, отображаемый для самой команды config (например, через --help)."
                }
              }
            },
            "ls": {
              "description": {
                "$message": {
                  "msg": "Список настроек для текущего профиля",
                  "description": {
                    "msg": "Однострочное описание подкоманды config ls, отображаемое в списках справки CLI."
                  }
                }
              },
              "usage_flags": {
                "$message": {
                  "msg": "[-a|--all]",
                  "description": {
                    "msg": "Краткая сводка флагов, отображаемая рядом с подкомандой ls в тексте использования."
                  }
                }
              },
              "usage": {
                "$message": {
                  "msg": "--profile=<имя-профиля> [флаги]",
                  "description": {
                    "msg": "Строка использования, отображаемая для подкоманды ls."
                  }
                }
              },
              "flag_all": {
                "$message": {
                  "msg": "Список всех настроек (по умолчанию текущий профиль), включая внутренние настройки",
                  "description": {
                    "msg": "Текст справки для флага --all подкоманды ls."
                  }
                }
              },
              "flag_describe": {
                "$message": {
                  "msg": "Описать настройки",
                  "description": {
                    "msg": "Текст справки для флага --describe подкоманды ls."
                  }
                }
              },
              "flag_prefix": {
                "$message": {
                  "msg": "Отобразить настройки с определенным префиксом",
                  "description": {
                    "msg": "Текст справки для флага --prefix подкоманды ls."
                  }
                }
              },
              "table_settings_descriptions": {
                "$message": {
                  "msg": "Описания настроек",
                  "description": {
                    "msg": "Заголовок, отображаемый над таблицей описаний настроек."
                  }
                }
              },
              "table_configuration_of": {
                "$message": {
                  "msg": "Конфигурация {app_name:s}",
                  "description": {
                    "msg": "Заголовок, отображаемый над таблицей конфигурации конкретного приложения.",
                    "args": {
                      "app_name": {
                        "description": "отображаемое имя приложения."
                      }
                    }
                  }
                }
              },
              "table_settings_for_profile": {
                "$message": {
                  "msg": "Настройки для текущего ПРОФИЛЯ: {profile:s}",
                  "description": {
                    "msg": "Заголовок, отображаемый над таблицей настроек текущего профиля.",
                    "args": {
                      "profile": {
                        "description": "имя текущего профиля."
                      }
                    }
                  }
                }
              },
              "table_application_config": {
                "$message": {
                  "msg": "Конфигурация приложения",
                  "description": {
                    "msg": "Заголовок, отображаемый над общей таблицей конфигурации приложения."
                  }
                }
              },
              "header_key": {
                "$message": {
                  "msg": "КЛЮЧ",
                  "description": {
                    "msg": "Заголовок столбца ключа таблицы настроек."
                  }
                }
              },
              "header_description": {
                "$message": {
                  "msg": "ОПИСАНИЕ",
                  "description": {
                    "msg": "Заголовок столбца описания таблицы настроек."
                  }
                }
              },
              "header_kind": {
                "$message": {
                  "msg": "ТИП",
                  "description": {
                    "msg": "Заголовок столбца типа таблицы настроек."
                  }
                }
              },
              "header_is_set": {
                "$message": {
                  "msg": "УСТАНОВЛЕНО",
                  "description": {
                    "msg": "Заголовок столбца «установлено» таблицы настроек."
                  }
                }
              },
              "header_mutability": {
                "$message": {
                  "msg": "ИЗМЕНЯЕМОСТЬ",
                  "description": {
                    "msg": "Заголовок столбца изменяемости таблицы настроек."
                  }
                }
              },
              "header_value": {
                "$message": {
                  "msg": "ЗНАЧЕНИЕ",
                  "description": {
                    "msg": "Заголовок столбца значения таблицы настроек."
                  }
                }
              },
              "header_default": {
                "$message": {
                  "msg": "ПО УМОЛЧАНИЮ",
                  "description": {
                    "msg": "Заголовок столбца значения по умолчанию таблицы настроек."
                  }
                }
              }
            },
            "set": {
              "description": {
                "$message": {
                  "msg": "Установить значение настройки",
                  "description": {
                    "msg": "Однострочное описание подкоманды config set, отображаемое в списках справки CLI."
                  }
                }
              },
              "usage": {
                "$message": {
                  "msg": "--profile=<имя-профиля>",
                  "description": {
                    "msg": "Строка использования, отображаемая для подкоманды set."
                  }
                }
              },
              "error_not_exists": {
                "$message": {
                  "msg": "настройка {key:s} не существует",
                  "description": {
                    "msg": "Ошибка, отображаемая, когда указанный ключ настройки не существует.",
                    "args": {
                      "key": {
                        "description": "запрошенный ключ настройки."
                      }
                    }
                  }
                }
              }
            },
            "get": {
              "description": {
                "$message": {
                  "msg": "Получить значение настройки или опции",
                  "description": {
                    "msg": "Однострочное описание подкоманды config get, отображаемое в списках справки CLI."
                  }
                }
              },
              "usage": {
                "$message": {
                  "msg": "--profile=<имя-профиля>",
                  "description": {
                    "msg": "Строка использования, отображаемая для подкоманды get."
                  }
                }
              },
              "flag_secret": {
                "$message": {
                  "msg": "Запрашивает ввод пароля секретов для отображения значения. Если пароль не установлен, выводит секретное значение <redacted> без запроса",
                  "description": {
                    "msg": "Текст справки для флага --secret подкоманды get."
                  }
                }
              },
              "error_not_exists": {
                "$message": {
                  "msg": "настройка {key:s} не существует",
                  "description": {
                    "msg": "Ошибка, отображаемая, когда указанный ключ настройки не существует.",
                    "args": {
                      "key": {
                        "description": "запрошенный ключ настройки."
                      }
                    }
                  }
                }
              },
              "error_invalid_password": {
                "$message": {
                  "msg": "неверный пароль",
                  "description": {
                    "msg": "Ошибка, отображаемая, когда введённый пароль секретов неверен."
                  }
                }
              },
              "redacted": {
                "$message": {
                  "msg": "<redacted>",
                  "description": {
                    "msg": "Текст-заполнитель, отображаемый вместо секретного значения, если пароль не был указан."
                  }
                }
              }
            },
            "add": {
              "description": {
                "$message": {
                  "msg": "Добавить заданное значение к значению настройки",
                  "description": {
                    "msg": "Однострочное описание подкоманды config add, отображаемое в списках справки CLI."
                  }
                }
              },
              "usage": {
                "$message": {
                  "msg": "--profile=<имя-профиля>",
                  "description": {
                    "msg": "Строка использования, отображаемая для подкоманды add."
                  }
                }
              },
              "error_not_exists": {
                "$message": {
                  "msg": "настройка {key:s} не существует",
                  "description": {
                    "msg": "Ошибка, отображаемая, когда указанный ключ настройки не существует.",
                    "args": {
                      "key": {
                        "description": "запрошенный ключ настройки."
                      }
                    }
                  }
                }
              },
              "error_not_slice": {
                "$message": {
                  "msg": "настройка {key:s} не является списком",
                  "description": {
                    "msg": "Ошибка, отображаемая, когда указанная настройка не является списком, поэтому в неё нельзя добавить значение.",
                    "args": {
                      "key": {
                        "description": "запрошенный ключ настройки."
                      }
                    }
                  }
                }
              },
              "error_already_exists": {
                "$message": {
                  "msg": "значение {value:s} для {key:s} уже существует",
                  "description": {
                    "msg": "Ошибка, отображаемая, когда указанное значение уже существует в списке настройки.",
                    "args": {
                      "key": {
                        "description": "запрошенный ключ настройки."
                      },
                      "value": {
                        "description": "указанное значение."
                      }
                    }
                  }
                }
              }
            },
            "remove": {
              "description": {
                "$message": {
                  "msg": "Удалить заданное значение из значения настройки",
                  "description": {
                    "msg": "Однострочное описание подкоманды config remove, отображаемое в списках справки CLI."
                  }
                }
              },
              "usage": {
                "$message": {
                  "msg": "--profile=<имя-профиля>",
                  "description": {
                    "msg": "Строка использования, отображаемая для подкоманды remove."
                  }
                }
              },
              "error_not_exists": {
                "$message": {
                  "msg": "настройка {key:s} не существует",
                  "description": {
                    "msg": "Ошибка, отображаемая, когда указанный ключ настройки не существует.",
                    "args": {
                      "key": {
                        "description": "запрошенный ключ настройки."
                      }
                    }
                  }
                }
              },
              "error_not_slice": {
                "$message": {
                  "msg": "настройка {key:s} не является списком",
                  "description": {
                    "msg": "Ошибка, отображаемая, когда указанная настройка не является списком, поэтому из неё нельзя удалить значение.",
                    "args": {
                      "key": {
                        "description": "запрошенный ключ настройки."
                      }
                    }
                  }
                }
              },
              "error_value_not_exists": {
                "$message": {
                  "msg": "значение {value:s} для {key:s} не существует",
                  "description": {
                    "msg": "Ошибка, отображаемая, когда указанного значения нет в списке настройки.",
                    "args": {
                      "key": {
                        "description": "запрошенный ключ настройки."
                      },
                      "value": {
                        "description": "указанное значение."
                      }
                    }
                  }
                }
              }
            },
            "reset": {
              "description": {
                "$message": {
                  "msg": "Сбросить настройку к значению по умолчанию",
                  "description": {
                    "msg": "Однострочное описание подкоманды config reset, отображаемое в списках справки CLI."
                  }
                }
              },
              "usage": {
                "$message": {
                  "msg": "--profile=<имя-профиля>",
                  "description": {
                    "msg": "Строка использования, отображаемая для подкоманды reset."
                  }
                }
              },
              "flag_all": {
                "$message": {
                  "msg": "сбросить все настройки",
                  "description": {
                    "msg": "Текст справки для флага --all подкоманды reset."
                  }
                }
              },
              "error_not_exists": {
                "$message": {
                  "msg": "настройка {key:s} не существует",
                  "description": {
                    "msg": "Ошибка, отображаемая, когда указанный ключ настройки не существует.",
                    "args": {
                      "key": {
                        "description": "запрошенный ключ настройки."
                      }
                    }
                  }
                }
              }
            },
            "prompt_secrets_password": {
              "$message": {
                "msg": "введите пароль секретов",
                "description": {
                  "msg": "Приглашение, показываемое при запросе у пользователя пароля секретов."
                }
              }
            }
          }
        },
        "help": {
          "commands": {
            "$message": {
              "msg": " КОМАНДЫ:",
              "description": {
                "msg": "Заголовок раздела, отображаемый над списком команд в справке CLI."
              }
            }
          },
          "flags": {
            "$message": {
              "msg": " ФЛАГИ:",
              "description": {
                "msg": "Заголовок раздела, отображаемый над списком флагов в справке CLI."
              }
            }
          },
          "shared_flags": {
            "$message": {
              "msg": " ОБЩИЕ ФЛАГИ:",
              "description": {
                "msg": "Заголовок раздела, отображаемый над списком общих флагов в справке CLI."
              }
            }
          },
          "global_flags": {
            "$message": {
              "msg": " ГЛОБАЛЬНЫЕ ФЛАГИ:",
              "description": {
                "msg": "Заголовок раздела, отображаемый над списком глобальных флагов в справке CLI."
              }
            }
          },
          "copyright": {
            "$message": {
              "msg": "Авторское право ©",
              "description": {
                "msg": "Метка, отображаемая перед строкой авторских прав в справке CLI."
              }
            }
          },
          "license": {
            "$message": {
              "msg": "Лицензия: ",
              "description": {
                "msg": "Метка, отображаемая перед строкой лицензии в справке CLI."
              }
            }
          },
          "default": {
            "$message": {
              "msg": "по умолчанию",
              "description": {
                "msg": "Слово, используемое для обозначения значения флага или настройки по умолчанию в справке CLI."
              }
            }
          }
        },
        "flags": {
          "version": {
            "$message": {
              "msg": "вывести версию приложения",
              "description": {
                "msg": "Текст справки для глобального флага --version."
              }
            }
          },
          "help": {
            "$message": {
              "msg": "показать справку или справку по команде. [...команда --help]",
              "description": {
                "msg": "Текст справки для глобального флага --help."
              }
            }
          },
          "show_exec": {
            "$message": {
              "msg": "флаг -x выводит все команды CLI по мере их выполнения.",
              "description": {
                "msg": "Текст справки для глобального флага -x."
              }
            }
          },
          "system_debug": {
            "$message": {
              "msg": "включить уровень логирования системной отладки (очень подробный)",
              "description": {
                "msg": "Текст справки для глобального флага --system-debug."
              }
            }
          },
          "debug": {
            "$message": {
              "msg": "включить уровень логирования отладки",
              "description": {
                "msg": "Текст справки для глобального флага --debug."
              }
            }
          },
          "verbose": {
            "$message": {
              "msg": "включить подробный уровень логирования",
              "description": {
                "msg": "Текст справки для глобального флага --verbose."
              }
            }
          },
          "x_prod": {
            "$message": {
              "msg": "ТОЛЬКО РАЗРАБОТКА: принудительно перевести приложение в производственный режим, установив app_is_devel в false при запуске из исходников.",
              "description": {
                "msg": "Текст справки для флага --x-prod, предназначенного только для разработки."
              }
            }
          }
        }
      }
    }
  }
}
