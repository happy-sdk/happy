{
  "version": 2,
  "bundle": "com.github.happy-sdk.happy.pkg.vars.varflag",
  "locales": {
    "ru": {
      "notes": "pkg/vars/varflag's own sentinel error messages.",
      "keys": {
        "invalid_arguments": {
          "$message": {
            "msg": "недопустимые аргументы",
            "description": {
              "msg": "Сообщение об ошибке для в целом недопустимых аргументов командной строки."
            }
          }
        },
        "invalid_command_or_args": {
          "$message": {
            "msg": "{name:s} не принимает команду или аргумент {arg:s}",
            "description": {
              "msg": "Сообщение об ошибке, возвращаемое, когда набору флагов передаётся команда или аргумент, который он не принимает.",
              "args": {
                "name": {
                  "description": "собственное имя набора флагов."
                },
                "arg": {
                  "description": "непринятая команда или значение аргумента."
                }
              }
            }
          }
        },
        "flag": {
          "$message": {
            "msg": "ошибка флага",
            "description": {
              "msg": "Сообщение об ошибке, возвращаемое при сбое инициализации флага."
            }
          }
        },
        "flag_exists": {
          "$message": {
            "msg": "флаг уже существует",
            "description": {
              "msg": "Сообщение об ошибке, возвращаемое, когда флаг с таким именем уже существует."
            }
          }
        },
        "alias_shadow": {
          "$message": {
            "msg": "псевдоним флага затенён",
            "description": {
              "msg": "Сообщение об ошибке, возвращаемое, когда псевдоним флага затеняется другим флагом."
            }
          }
        },
        "parse": {
          "$message": {
            "msg": "ошибка разбора флага",
            "description": {
              "msg": "Сообщение об ошибке для общих ошибок разбора флагов."
            }
          }
        },
        "missing_value": {
          "$message": {
            "msg": "отсутствует значение флага",
            "description": {
              "msg": "Сообщение об ошибке, возвращаемое, когда значение флага отсутствует в разобранных аргументах."
            }
          }
        },
        "invalid_value": {
          "$message": {
            "msg": "недопустимое значение флага",
            "description": {
              "msg": "Сообщение об ошибке, возвращаемое, когда для флага указано недопустимое значение."
            }
          }
        },
        "flag_already_parsed": {
          "$message": {
            "msg": "флаг уже разобран",
            "description": {
              "msg": "Сообщение об ошибке, возвращаемое, когда флаг уже был разобран."
            }
          }
        },
        "missing_required": {
          "$message": {
            "msg": "отсутствует обязательный флаг",
            "description": {
              "msg": "Сообщение об ошибке, возвращаемое, когда обязательный флаг отсутствует в наборе аргументов."
            }
          }
        },
        "missing_options": {
          "$message": {
            "msg": "отсутствуют опции",
            "description": {
              "msg": "Сообщение об ошибке, возвращаемое, когда парсер флага опций не находит ни одной опции."
            }
          }
        },
        "no_named_flag": {
          "$message": {
            "msg": "нет такого флага",
            "description": {
              "msg": "Сообщение об ошибке, возвращаемое, когда поиск флага не находит флаг с таким именем."
            }
          }
        }
      }
    }
  }
}
